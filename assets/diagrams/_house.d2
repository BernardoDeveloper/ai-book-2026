# House style (docs/research/IMAGES.md §4). Import at the top of every diagram:
#   ...@_house
vars: { d2-config: { theme-id: 0; pad: 40; theme-overrides: { B1: "#1B2238"; B2: "#1B2238" } } }
style.fill: "#FBF9F4"
classes: {
  navy: { style: { fill: "#2B3A67"; font-color: "#FBF9F4"; stroke: "#1B2238"; stroke-width: 2; border-radius: 6 } }
  teal: { style: { fill: "#2F7F86"; font-color: "#FBF9F4"; stroke: "#1B2238"; stroke-width: 2; border-radius: 6 } }
  sand: { style: { fill: "#E9DFC9"; font-color: "#1B2238"; stroke: "#1B2238"; stroke-width: 2; border-radius: 6 } }
  gray: { style: { fill: "#8A8F98"; font-color: "#FBF9F4"; stroke: "#1B2238"; stroke-width: 2; border-radius: 6 } }
  accent: { style: { fill: "#E3A23B"; font-color: "#1B2238"; stroke: "#1B2238"; stroke-width: 2; border-radius: 6 } }
  danger: { style: { fill: "#B5523B"; font-color: "#FBF9F4"; stroke: "#1B2238"; stroke-width: 2; border-radius: 6 } }
  note: { shape: text; style: { font-color: "#1B2238"; italic: true } }
}
